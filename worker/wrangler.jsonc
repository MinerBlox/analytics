{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "affiliate-analytics-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": ["15 1 * * *"]
  }
}
